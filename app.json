{
  "expo": {
    "name": "home-nader",
    "slug": "real-home-van",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.homenader.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.homenader.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14213d"
      }
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "expo-web-browser"
    ],
    "owner": "homenader",
    "extra": {
      "eas": {
        "projectId": "ef147604-5085-4817-b2bd-8224da9edab7"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png",
      "name": "home-nader",
      "shortName": "home-nader",
      "backgroundColor": "#ffffff",
      "themeColor": "#14213d"
    }
  }
}
